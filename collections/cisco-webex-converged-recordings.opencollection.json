{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco Webex Converged Recordings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Converged Recordings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cisco Webex List Converged Recordings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/convergedRecordings",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "List recordings after this date and time in ISO 8601 format."
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "List recordings before this date and time in ISO 8601 format."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by recording status."
              },
              {
                "name": "serviceType",
                "value": "",
                "type": "query",
                "description": "Filter by Webex service type."
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Maximum number of recordings to return (default 10, max 100)."
              }
            ]
          },
          "docs": "Lists converged recordings from Webex Meetings and Webex Calling. Provides a unified view of recordings across multiple services. Supports filtering by date range, status, and service type."
        },
        {
          "info": {
            "name": "Cisco Webex Get Converged Recording Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/convergedRecordings/:recordingId",
            "params": [
              {
                "name": "recordingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the recording."
              }
            ]
          },
          "docs": "Shows details for a converged recording by ID. Returns the recording metadata, download links, and service-specific details."
        },
        {
          "info": {
            "name": "Cisco Webex Delete a Converged Recording",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://webexapis.com/v1/convergedRecordings/:recordingId",
            "params": [
              {
                "name": "recordingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the recording."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes a converged recording by ID. The recording is soft-deleted and can be recovered within a retention period."
        }
      ]
    }
  ],
  "bundled": true
}