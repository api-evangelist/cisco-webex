        {
          "id": "375bd174-c080-46c0-9912-0a0dd25a5d6b",
          "name": "Cisco Webex List Messages",
          "request": {
            "name": "Cisco Webex List Messages",
            "description": {
              "content": "Lists all messages in a room. Each message includes content and metadata about the message. The list sorts the messages in descending order by creation date.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "roomId",
                  "value": "<string>",
                  "description": "(Required) Unique identifier for the room to list messages from."
                },
                {
                  "disabled": false,
                  "key": "parentId",
                  "value": "<string>",
                  "description": "List messages that are replies to the specified parent message."
                },
                {
                  "disabled": false,
                  "key": "mentionedPeople",
                  "value": "<string>",
                  "description": "List messages where the specified person is mentioned. Use 'me' for the authenticated user."
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<dateTime>",
                  "description": "List messages sent before a date and time in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "beforeMessage",
                  "value": "<string>",
                  "description": "List messages sent before a specified message ID."
                },
                {
                  "disabled": false,
                  "key": "max",
                  "value": "50",
                  "description": "Maximum number of messages to return (default 50, max 1000)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
