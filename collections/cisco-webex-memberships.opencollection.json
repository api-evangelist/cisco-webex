{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco Webex Memberships API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Memberships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cisco Webex List Memberships",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/memberships",
            "params": [
              {
                "name": "roomId",
                "value": "",
                "type": "query",
                "description": "Filter memberships by room ID."
              },
              {
                "name": "personId",
                "value": "",
                "type": "query",
                "description": "Filter memberships by person ID."
              },
              {
                "name": "personEmail",
                "value": "",
                "type": "query",
                "description": "Filter memberships by person email address."
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Maximum number of memberships to return (default 100)."
              }
            ]
          },
          "docs": "Lists all room memberships. Filter by room ID, person ID, or person email. Results are paginated and include membership status and roles."
        },
        {
          "info": {
            "name": "Cisco Webex Create a Membership",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://webexapis.com/v1/memberships",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a person to a room. The person can be specified by person ID or email address. Optionally set the person as a room moderator."
        },
        {
          "info": {
            "name": "Cisco Webex Get Membership Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/memberships/:membershipId",
            "params": [
              {
                "name": "membershipId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the membership."
              }
            ]
          },
          "docs": "Shows details for a membership by ID. Returns the membership configuration including role and hidden status."
        },
        {
          "info": {
            "name": "Cisco Webex Update a Membership",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://webexapis.com/v1/memberships/:membershipId",
            "params": [
              {
                "name": "membershipId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the membership."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates properties of a membership by ID. Allows changing the moderator status and visibility of direct spaces."
        },
        {
          "info": {
            "name": "Cisco Webex Delete a Membership",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://webexapis.com/v1/memberships/:membershipId",
            "params": [
              {
                "name": "membershipId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the membership."
              }
            ]
          },
          "docs": "Deletes a membership by ID. The person is removed from the room and can no longer access the room's content."
        }
      ]
    }
  ],
  "bundled": true
}