          "request": {
            "name": "Cisco Webex List Converged Recordings",
            "description": {
              "content": "Lists converged recordings from Webex Meetings and Webex Calling. Provides a unified view of recordings across multiple services. Supports filtering by date range, status, and service type.",
              "type": "text/plain"
            },
            "url": {
