{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco Webex Roles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cisco Webex List Roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/roles"
          },
          "docs": "Lists all roles available in the organization. Must be called by an admin user. Returns role names and unique identifiers."
        },
        {
          "info": {
            "name": "Cisco Webex Get Role Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/roles/:roleId",
            "params": [
              {
                "name": "roleId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the role."
              }
            ]
          },
          "docs": "Shows details for a role by ID. Returns the role name and unique identifier. Must be called by an admin user."
        }
      ]
    }
  ],
  "bundled": true
}