{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco Webex Recordings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Recordings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cisco Webex List Recordings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/recordings",
            "params": [
              {
                "name": "meetingId",
                "value": "",
                "type": "query",
                "description": "Filter recordings by meeting ID."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "List recordings after this date and time in ISO 8601 format."
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "List recordings before this date and time in ISO 8601 format."
              },
              {
                "name": "hostEmail",
                "value": "",
                "type": "query",
                "description": "Email of the meeting host (admin use)."
              },
              {
                "name": "siteUrl",
                "value": "",
                "type": "query",
                "description": "Webex site URL to filter recordings."
              },
              {
                "name": "integrationTag",
                "value": "",
                "type": "query",
                "description": "Integration tag to filter recordings."
              },
              {
                "name": "topic",
                "value": "",
                "type": "query",
                "description": "Filter by recording topic."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Filter by recording format."
              },
              {
                "name": "serviceType",
                "value": "",
                "type": "query",
                "description": "Filter by Webex service type."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by recording status."
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Maximum number of recordings to return (default 10, max 100)."
              }
            ]
          },
          "docs": "Lists recordings for the authenticated user. Supports filtering by meeting ID, date range, format, service type, and status."
        },
        {
          "info": {
            "name": "Cisco Webex Get Recording Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/recordings/:recordingId",
            "params": [
              {
                "name": "recordingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the recording."
              },
              {
                "name": "hostEmail",
                "value": "",
                "type": "query",
                "description": "Email of the meeting host (admin use)."
              }
            ]
          },
          "docs": "Shows details for a recording by ID. Includes download URLs, playback links, and temporary direct download links with expiration."
        },
        {
          "info": {
            "name": "Cisco Webex Delete a Recording",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://webexapis.com/v1/recordings/:recordingId",
            "params": [
              {
                "name": "recordingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the recording."
              },
              {
                "name": "hostEmail",
                "value": "",
                "type": "query",
                "description": "Email of the meeting host (admin use)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes a recording by ID. Compliance officers must provide a reason for the deletion. The recording is soft-deleted and can be purged later."
        }
      ]
    },
    {
      "info": {
        "name": "Admin Recordings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cisco Webex List Recordings for Admin or Compliance Officer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://webexapis.com/v1/admin/recordings",
            "params": [
              {
                "name": "meetingId",
                "value": "",
                "type": "query",
                "description": "Filter recordings by meeting ID."
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "List recordings after this date and time in ISO 8601 format."
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "List recordings before this date and time in ISO 8601 format."
              },
              {
                "name": "hostEmail",
                "value": "",
                "type": "query",
                "description": "Email of the meeting host."
              },
              {
                "name": "siteUrl",
                "value": "",
                "type": "query",
                "description": "Webex site URL."
              },
              {
                "name": "topic",
                "value": "",
                "type": "query",
                "description": "Filter by recording topic."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Filter by recording format."
              },
              {
                "name": "serviceType",
                "value": "",
                "type": "query",
                "description": "Filter by Webex service type."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by recording status."
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Maximum number of recordings to return (default 10, max 100)."
              }
            ]
          },
          "docs": "Lists recordings for admin or compliance officer access. Includes additional fields such as host display name and email. Supports extended filtering capabilities."
        },
        {
          "info": {
            "name": "Cisco Webex Delete a Recording By Admin",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://webexapis.com/v1/admin/recordings/:recordingId",
            "params": [
              {
                "name": "recordingId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the recording."
              }
            ]
          },
          "docs": "Deletes a recording by admin using the recording ID. Available only to organization administrators."
        }
      ]
    }
  ],
  "bundled": true
}