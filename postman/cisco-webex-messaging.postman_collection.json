        {
          "name": "Cisco Webex List Messages",
          "id": "08200559-28af-46fa-949c-03b78280ea0b",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages?roomId=<string>&parentId=<string>&mentionedPeople=<string>&before=<dateTime>&beforeMessage=<string>&max=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "messages"
              ],
              "query": [
                {
                  "description": "(Required) Unique identifier for the room to list messages from.",
                  "key": "roomId",
                  "value": "<string>"
                },
                {
                  "description": "List messages that are replies to the specified parent message.",
                  "key": "parentId",
                  "value": "<string>"
                },
                {
                  "description": "List messages where the specified person is mentioned. Use 'me' for the authenticated user.",
                  "key": "mentionedPeople",
                  "value": "<string>"
                },
                {
                  "description": "List messages sent before a date and time in ISO 8601 format.",
                  "key": "before",
                  "value": "<dateTime>"
                },
                {
                  "description": "List messages sent before a specified message ID.",
                  "key": "beforeMessage",
                  "value": "<string>"
                },
                {
                  "description": "Maximum number of messages to return (default 50, max 1000).",
                  "key": "max",
                  "value": "50"
                }
              ]
            },
            "description": "Lists all messages in a room. Each message includes content and metadata about the message. The list sorts the messages in descending order by creation date."
          },
          "response": [
            {
              "id": "9fdc3bb1-a376-4fb8-b320-c79ddef2cdc9",
